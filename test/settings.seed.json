// settings.json seeded by the mme regression suite.
// Every value here exists to make a run byte-identical to the last one:
// no language servers (their replies are asynchronous and machine dependent,
// and an empty {} is not enough: mme then falls back to its built-in table),
// no VS Code extensions (they live outside this tree), no blinking cursor,
// no restored session, no welcome page, no timed suggestions.
// A scenario can put its own values over these with Scen(settings={...}).
{
  "workbench.colorTheme": "Dark Modern",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.minimap.enabled": true,
  "editor.wordWrap": "off",
  "editor.lineNumbers": "on",
  "editor.autoClosingBrackets": "always",
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 5,
  "editor.occurrencesHighlight": true,
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.rulers": [],
  "editor.inlayHints.enabled": "on",
  "editor.codeLens": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.lightbulb.enabled": "onCode",
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.codeActionsOnSave": {},
  "editor.linkedEditing": false,
  "testing.gutterEnabled": true,
  "debug.inlineValues": "auto",
  "editor.wordBasedSuggestions": true,
  "editor.snippetSuggestions": "inline",
  "editor.renderWhitespace": "selection",
  "files.trimTrailingWhitespace": false,
  "files.insertFinalNewline": false,
  "workbench.sideBar.visible": true,
  "workbench.editor.enablePreview": false,
  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "left",
  "window.menuBarVisibility": "classic",
  "workbench.statusBar.visible": true,
  "workbench.activityBar.location": "default",
  "files.autoSave": "off",
  "files.autoSaveDelay": 1000,
  "files.hotExit": "off",
  "window.restoreWindows": "none",
  "files.encoding": "utf8",
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "solid",
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": true,
  "git.enableSmartCommit": false,
  "git.mergeEditor": true,
  "scm.diffDecorations": "all",
  "terminal.integrated.shell": "",
  "terminal.integrated.defaultProfile.windows": "",
  "mme.extensions.useVSCodeExtensions": false,
  "editor.textmateGrammars": true,
  "editor.maxTokenizationLineLength": 20000,
  "editor.mouseWheelScrollSensitivity": 1,
  "editor.autoIndent": "full",
  "editor.autoIndentOnPaste": false,
  "editor.tabCompletion": "off",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "other": "off",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.multiCursorModifier": "alt",
  "editor.multiCursorPaste": "spread",
  "editor.emptySelectionClipboard": true,
  "editor.renderControlCharacters": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.renderLineHighlight": "line",
  "editor.cursorSurroundingLines": 0,
  "editor.scrollBeyondLastLine": true,
  "workbench.editor.decorations.colors": true,
  "workbench.editor.decorations.badges": true,
  "editor.minimap.side": "right",
  "editor.minimap.showSlider": "mouseover",
  "editor.minimap.renderCharacters": true,
  "editor.minimap.maxColumn": 120,
  "editor.minimap.scale": 1,
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.hideUnchangedRegions.enabled": false,
  "diffEditor.renderSideBySide": true,
  "editor.hover.delay": 300,
  "editor.hover.sticky": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.rightClickBehavior": "copyPaste",
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.scrollback": 1000,
  "terminal.integrated.cwd": "",
  "terminal.integrated.env.windows": {},
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.confirmOnExit": "never",
  "window.commandCenter": true,
  "window.title": "",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.panel.alignment": "center",
  "explorer.confirmDragAndDrop": true,
  "explorer.confirmDelete": true,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": false,
  "explorer.fileNesting.expand": true,
  "explorer.sortOrder": "default",
  "explorer.autoReveal": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "mme.languageServers": {
    "c": "",
    "cpp": "",
    "go": "",
    "rust": "",
    "python": "",
    "javascript": "",
    "typescript": "",
    "typescriptreact": "",
    "javascriptreact": "",
    "zig": "",
    "lua": "",
    "csharp": "",
    "java": "",
    "php": "",
    "ruby": "",
    "kotlin": "",
    "dart": "",
    "haskell": "",
    "elixir": "",
    "html": "",
    "css": "",
    "scss": "",
    "less": "",
    "json": "",
    "jsonc": "",
    "shellscript": "",
    "yaml": "",
    "dockerfile": "",
    "sql": "",
    "swift": "",
    "scala": "",
    "nim": "",
    "odin": "",
    "v": "",
    "julia": "",
    "erlang": "",
    "r": "",
    "perl": "",
    "cmake": "",
    "graphql": "",
    "proto": "",
    "terraform": "",
    "vue": "",
    "svelte": "",
    "latex": "",
    "objective-c": "",
    "powershell": "",
    "xml": "",
    "toml": "",
    "markdown": ""
  },
  "markdown.preview.scrollPreviewWithEditor": true,
  "markdown.preview.scrollEditorWithPreview": true,
  "github.copilot.nextEditSuggestions.enabled": true
}
